# ── App ───────────────────────────────────────────────────
APP_NAME=CrisisNet API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ── Frontend ───────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# ── Mapbox ─────────────────────────────────────────────────
# Public token (pk.*) — used for Directions API calls
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here
# Secret token (sk.*) — used for downloading Mapbox resources
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_token_here

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_WEATHER_MODEL=gpt-4.1-mini

# ── IBM watsonx (optional) ─────────────────────────────────
# Leave blank to use the rule-based fallback in simulation mode.
WATSONX_API_KEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL=""
